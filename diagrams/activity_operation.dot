digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.45, dpi=200];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=12, color="#2F5597", fillcolor="#EAF2F8", margin="0.18,0.10"];
edge [fontname="Times New Roman", fontsize=10, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить команду пользователя\n(submit, approve, reject, cancel, complete)", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Определить текущий статус заявки (getStatus)"];
n3 [label="A1 Проверить допустимость перехода:\lsubmit — только из DRAFT (R3);\lapprove, reject — только из SUBMITTED (R5);\lcancel — не из REJECTED, CANCELLED, COMPLETED (R7);\lcomplete — только из APPROVED (R8)\l"];
n4 [label="Переход допустим?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="A2 Проверить данные операции:\lreject — причина не null и длина >= 10 (R6);\lcomplete — today >= end (R9);\lsubmit через сервис — у сотрудника нет\lдругой активной заявки (вариант 26)\l"];
n8 [label="Данные корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Изменить состояние заявки (status = новый статус);\lпри reject сохранить rejectionReason\l"];
n7 [label="Зафиксировать ошибку без изменения объекта:\lIllegalStateException — недопустимый переход,\lIllegalArgumentException — неверные данные\l"];
start -> n1 -> n2 -> n3 -> n4;
n4 -> n5 [label=" да"];
n4 -> n7 [label=" нет: ISE"];
n5 -> n8;
n8 -> n6 [label=" да"];
n8 -> n7 [label=" нет: IAE (R6) / ISE (R9, вариант 26)"];
n6 -> end;
n7 -> end;
}
